# Express API origin. Public catalog, authentication and admin requests use this URL.
VITE_BACKEND_URL=http://localhost:4000
# Optional separate Socket.IO origin. Defaults to VITE_BACKEND_URL.
VITE_SOCKET_URL=http://localhost:4000
# Enable Google sign-in only with a configured OAuth web client and a backend
# /api/v1/auth/google endpoint that verifies the supplied Google ID credential.
VITE_GOOGLE_CLIENT_ID=

